# Vise settings: copy to ~/.vise/.env (or use the settings page). Missing or empty values use the defaults.

# LLM server (llama.cpp, OpenAI-compatible)
VISE_LLM_URL=http://localhost:8080
VISE_LLM_API_KEY=
VISE_LLM_MODEL=RentedNoodle/Qwen3.8-27B-OrcaRouter-GSQ-RCO-IQ3_XXS-Uncensored:QATFA
VISE_EMBEDDING_MODEL=
VISE_SLOT_REQUEST_TIMEOUT_MS=5000

# Provider: local (llama.cpp, above) or openrouter. OpenRouter is hosted:
# the conversation and tool results leave this machine.
VISE_LLM_PROVIDER=local
VISE_OPENROUTER_URL=https://openrouter.ai/api/v1
VISE_OPENROUTER_API_KEY=
VISE_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Web server
PORT=3000

# Context compaction and long turns
VISE_RECENT_TURNS_TO_KEEP=2
VISE_ROUNDS_TO_KEEP=10
VISE_TAIL_SHARE=0.25
VISE_IN_TURN_COMPACTION_THRESHOLD=0.75
VISE_COMPACTION_THRESHOLD=0.9
VISE_SAVE_EVERY_ROUNDS=25
VISE_AUDIT=1
VISE_AUDIT_RETENTION_DAYS=0
VISE_MAX_CALL_TOKENS=32768
VISE_LOOP_GUARD=1
VISE_LOOP_RETRIES=1
VISE_PROGRESS_EVERY_ROUNDS=50

# Goal checking
VISE_GOAL_MAX_SAME_STEP=4
VISE_GOAL_CONTINUES_BEFORE_ASKING=8

# Prompt and display size
VISE_STARTUP_NOTE_LIMIT=30
VISE_TREE_MAX_DEPTH=5
VISE_TREE_MAX_ENTRIES=25
VISE_TOOL_LINE_PART_MAX=60
VISE_TOOL_LINE_DETAIL_MAX=140

# Tool output and files
VISE_RESULT_MAX_LINES=250
VISE_RESULT_MAX_CHARS=20000
VISE_PREVIEW_LINES=40
VISE_PREVIEW_CHARS=2000
VISE_SEARCH_MAX_MATCHES=100
VISE_SEARCH_MAX_MATCH_CHARS=300
VISE_TEMP_STALE_MS=86400000
VISE_TEMP_HEARTBEAT_MS=3600000
VISE_TOOL_SEARCH_MAX_RESULTS=5
VISE_MAX_IMAGE_BYTES=10000000
VISE_MAX_PICTURES=6
VISE_WEB_MAX_FILE_BYTES=262144
VISE_HISTORY_MAX_ENTRIES=400
VISE_SHELL_TIMEOUT_MS=60000

# Browser tools
VISE_BROWSER_MAX_OUTLINE_CHARS=30000
VISE_BROWSER_MAX_ELEMENTS=200
VISE_BROWSER_MAX_SCANNED=1000
VISE_BROWSER_MAX_UPLOAD_BYTES=10000000
VISE_WAIT_POLL_MS=250
VISE_WAIT_QUIET_MS=600
VISE_WAIT_MIN_IDLE_MS=1500
VISE_WAIT_PROBE_TIMEOUT_MS=2000
VISE_WAIT_DEFAULT_SECONDS=10
VISE_WAIT_MAX_SECONDS=60
VISE_TAB_SETTLE_MS=300
VISE_CHROMIUM_LOAD_TIMEOUT_MS=15000
VISE_CHROMIUM_LAUNCH_TIMEOUT_MS=15000
VISE_FIREFOX_LOAD_TIMEOUT_MS=15000
VISE_FIREFOX_LAUNCH_TIMEOUT_MS=20000
VISE_FIREFOX_TITLE_TIMEOUT_MS=1500
VISE_PLAYWRIGHT_TIMEOUT_MS=30000
VISE_LIVE_VIEW_FRAME_MS=200
VISE_EXTENSION_CALL_TIMEOUT_MS=30000
VISE_TAB_LIMIT=5

# Integrated terminal (web UI)
VISE_TERMINAL_SHELL=powershell.exe -NoLogo
VISE_TERMINAL_SCROLLBACK_KB=256
VISE_TERMINAL_IDLE_MINUTES=10

# MCP servers (configured under "mcpServers" in .viserc.json or ~/.vise/mcp.json)
VISE_MCP_CONNECT_TIMEOUT_MS=15000
VISE_MCP_TOOL_TIMEOUT_MS=120000
