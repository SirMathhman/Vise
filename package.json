{
  "name": "vise",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "build:web": "bun build ./web/src/app.ts --outdir ./web/dist --target browser --minify",
    "web": "bun run build:web && bun src/web/main.ts",
    "dev:web": "bun run scripts/dev-web.ts",
    "typecheck:web": "tsc --project web/tsconfig.json",
    "test": "bun test",
    "lint": "eslint src/ test/ index.ts web/ extension/",
    "build:ext": "bun scripts/build-ext.ts",
    "typecheck:ext": "tsc --project extension/tsconfig.json",
    "build:exe": "bun scripts/build-exe.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/firefox-webext-browser": "^143.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "rcedit": "^5.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "playwright-core": "^1.63.0",
    "webview-bun": "^2.4.0"
  }
}
