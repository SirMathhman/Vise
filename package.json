{
  "name": "vise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "preview": "npm run preview -w web",
    "lint:pmd:cpd:js": "pmd cpd --dir ./apps/server --dir ./apps/web/src --language ecmascript --minimum-tokens 100 --ignore-identifiers --ignore-literals",
    "lint:all": "npm run lint:all --workspaces && npm run lint:pmd:cpd:js"
  }
}
