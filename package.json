{
  "name": "vise",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start:backend": "bun --filter backend start",
    "dev:frontend": "bun --filter frontend dev",
    "build:frontend": "bun --filter frontend build",
    "build": "bun run --if-present --filter '*' build",
    "typecheck": "bun run --if-present --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0"
  }
}
