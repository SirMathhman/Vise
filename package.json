{
  "name": "vise",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "build:web": "bun build ./web/src/app.ts --outdir ./web/dist --target browser --minify",
    "web": "bun run build:web && bun src/web/main.ts",
    "dev:web": "bun run build:web && bun --watch src/web/main.ts",
    "typecheck:web": "tsc --project web/tsconfig.json",
    "test": "bun test",
    "lint": "eslint src/ test/ index.ts web/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  }
}
